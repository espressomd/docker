FROM ubuntu:resolute
RUN apt-get update && \
    echo "path-include=/usr/share/doc/libprrte-dev/help-*" >> /etc/dpkg/dpkg.cfg.d/excludes && \
    DEBIAN_FRONTEND=noninteractive TZ=Europe/Berlin apt-get install --no-install-recommends -y \
        apt-utils \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        ccache \
        clang-22 clang-tidy-22 clang-format-22 llvm-22 libc++-22-dev libclang-rt-22-dev libomp-22-dev \
        cmake \
        cmake-format \
        curl \
        cython3 \
        diffutils \
        doxygen \
        ffmpeg \
        gcc-13 g++-13 libstdc++-13-dev \
        gcc-15 g++-15 libstdc++-15-dev \
        gdb \
        gfortran \
        git \
        gnupg \
        graphviz \
        gzip \
        ipython3 \
        jq \
        jupyter-client \
        jupyter-core \
        jupyter-nbconvert \
        lcov \
        libblas-dev \
        libboost-dev \
        libboost-mpi-dev \
        libboost-serialization-dev \
        libboost-test-dev \
        libdigest-sha-perl \
        libfftw3-dev \
        libfftw3-mpi-dev \
        libgsl-dev \
        libhdf5-openmpi-dev \
        liblapack-dev \
        libnlopt-cxx-dev  \
        libopenmpi-dev \
        libprrte-dev \
        libthrust-dev \
        libtool \
        ninja-build \
        nvidia-cuda-toolkit \
        openmpi-bin \
        openssh-client \
        perl \
        pkg-config \
        pre-commit \
        pylint \
        python3 \
        python3-ase \
        python3-autopep8 \
        python3-coverage \
        python3-dev \
        python3-h5py \
        python3-ipykernel \
        python3-jinja2 \
        python3-lxml \
        python3-matplotlib \
        python3-nbconvert \
        python3-numpy \
        python3-numpydoc \
        python3-packaging \
        python3-pandas \
        python3-pep8 \
        python3-pint \
        python3-pip \
        python3-pycodestyle \
        python3-requests \
        python3-scipy \
        python3-setuptools \
        python3-sympy \
        python3-sphinx \
        python3-sphinxcontrib.bibtex \
        python3-sphinx-tabs \
        python3-tqdm \
        python3-venv \
        python3-vtk9 \
        rsync \
        texlive-base \
        unzip \
        vim && \
    if [ ! -f /usr/lib/x86_64-linux-gnu/prrte3/share/prte/help-prun.txt ]; then \
        # fix a packaging issue: https://bugs.launchpad.net/ubuntu/+source/openmpi/+bug/2155666
        mkdir -p /usr/lib/x86_64-linux-gnu/prrte3/share/prte && \
        cp /usr/share/doc/libprrte-dev/help-schizo-ompi.txt /usr/lib/x86_64-linux-gnu/prrte3/share/prte/ && \
        cp /usr/share/doc/libprrte-dev/help-prun.txt.gz /usr/lib/x86_64-linux-gnu/prrte3/share/prte/ && \
        gzip -d /usr/lib/x86_64-linux-gnu/prrte3/share/prte/help-prun.txt.gz ; \
    fi && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY install-pfft.sh /tmp
COPY install-scafacos.sh /tmp

RUN sh /tmp/install-pfft.sh     && rm /tmp/install-pfft.sh && \
    sh /tmp/install-scafacos.sh && rm /tmp/install-scafacos.sh && \
    ldconfig

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES="compute,utility"
ENV JUPYTER_PLATFORM_DIRS=1

COPY --chown=1000:1000 jupyter_nbconvert_config.json /tmp

RUN userdel ubuntu && rm -rf /home/ubuntu && useradd -u 1000 -m espresso
ENV HOME="/home/espresso"
RUN echo | cpan && \
    echo | cpan JSON::XS && \
    chown -R espresso:espresso /home/espresso/.cpan/
USER espresso
ENV VIRTUAL_ENV="$HOME/venv"
ENV PATH="$HOME/.local/bin:$VIRTUAL_ENV/bin:$PATH"
RUN cd "${HOME}" && \
  python3 -m venv --system-site-packages venv && \
  . venv/bin/activate && \
  python3 -m pip install --no-cache \
    jupyterlab==4.5.11 \
    sphinx-toggleprompt==0.6.0 && \
  jupyter_config_root=$(jupyter --paths --json | jq -r ".config[0]") && \
  mkdir -p "${jupyter_config_root}" && \
  mv "/tmp/jupyter_nbconvert_config.json" "${jupyter_config_root}/" && \
  deactivate
WORKDIR /home/espresso
